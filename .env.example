NODE_ENV=development
PORT=5000

# MongoDB Atlas — see README.md for team connection details
MONGODB_URI=mongodb+srv://<username>:<password>@parking-system.z4ngm7b.mongodb.net/parking-building-management-system?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# PayOS — lấy tại https://my.payos.vn → Kênh thanh toán → Thông tin xác thực API
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Client origin(s) — CORS allowlist (also used for PayOS returnUrl/cancelUrl).
# Comma-separated: FE web (Vite default 5173) + Mobile Expo web (Metro default 8081).
CLIENT_URL=http://localhost:5173,http://localhost:8081
# Canonical FE URL used in reset-password emails and PayOS return/cancel links.
FRONTEND_URL=http://localhost:5173

# Nodemailer — Gmail SMTP (use App Password, not account password)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google Gemini — AI camera nhận diện biển số + hãng xe (FREE)
# Lấy key tại: https://aistudio.google.com/apikey  (không cần thẻ tín dụng)
# Tùy chọn: app vẫn chạy nếu thiếu, nhưng endpoint /scan sẽ trả 503.
GEMINI_API_KEY=your_gemini_api_key

# OCR provider cho camera cổng: "gemini" | "paddle"
# Bỏ trống → tự chọn: có PADDLE_OCR_URL dùng paddle, có GEMINI_API_KEY dùng gemini.
# Không có gì được cấu hình → endpoint /scan trả lỗi 503 (KHÔNG có mock fallback).
OCR_PROVIDER=

# PaddleOCR microservice (self-hosted, miễn phí, chạy offline) — xem ocr-service/README.md
# PADDLE_OCR_URL=http://localhost:8868

# eSMS.vn — gửi OTP SMS cho quên mật khẩu qua điện thoại (Mobile). Đăng ký tại https://esms.vn
# Tùy chọn: app vẫn chạy nếu thiếu, nhưng endpoint /forgot-password-sms sẽ trả lỗi 500 khi gửi.
ESMS_API_KEY=your_esms_api_key
ESMS_SECRET_KEY=your_esms_secret_key
# ESMS_BRANDNAME=your_registered_brandname

# Gate kiosk â€” a long random secret provisioned only on the managed physical device.
# Do not put this value in the public web/mobile frontend.
KIOSK_DEVICE_TOKEN=replace_with_a_long_random_secret

# Vehicle QR token lifetime, in days. A vehicle's QR works at every building, so this
# is a single system-wide value; it is deliberately NOT configurable per building.
# Expired tokens are rejected at the gate and reissued when the owner opens the app.
VEHICLE_QR_TTL_DAYS=2
